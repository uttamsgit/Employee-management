name: Employee Center CI

on:
  push:
    branches:
      - main
  pull_request:
    branches:
      - main
  workflow_dispatch:

permissions:
  contents: read

jobs:
  frontend-build:
    name: Frontend Build
    runs-on: ubuntu-latest

    steps:
      - name: Checkout source code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
          cache-dependency-path: frontend/package-lock.json

      - name: Install dependencies
        working-directory: frontend
        run: npm install

      - name: Build frontend
        working-directory: frontend
        run: npm run build

  backend-validation:
    name: Backend Validation
    runs-on: ubuntu-latest

    steps:
      - name: Checkout source code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
          cache-dependency-path: backend/package-lock.json

      - name: Install dependencies
        working-directory: backend
        run: npm install

      - name: Generate Prisma Client
        working-directory: backend
        run: npm run prisma:generate

      - name: Validate JavaScript syntax
        working-directory: backend
        run: |
          find src prisma -name '*.js' -print0 | xargs -0 -n1 node --check

  secret-scanning:
    name: Gitleaks Secret Scan
    runs-on: ubuntu-latest

    steps:
      - name: Checkout source code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Scan for exposed secrets
        uses: gitleaks/gitleaks-action@v2

  docker-build:
    name: Docker Build and Trivy Scan
    runs-on: ubuntu-latest

    needs:
      - frontend-build
      - backend-validation
      - secret-scanning

    steps:
      - name: Checkout source code
        uses: actions/checkout@v4

      - name: Build backend image
        run: |
          docker build -t employee-center-backend:${{ github.sha }} ./backend

      - name: Build frontend image
        run: |
          docker build -t employee-center-frontend:${{ github.sha }} ./frontend

      - name: Install Trivy
        uses: aquasecurity/setup-trivy@v0.2.3

      - name: Scan backend image
        run: |
          trivy image \
            --exit-code 1 \
            --severity HIGH,CRITICAL \
            --ignore-unfixed \
            employee-center-backend:${{ github.sha }}

      - name: Scan frontend image
        run: |
          trivy image \
            --exit-code 1 \
            --severity HIGH,CRITICAL \
            --ignore-unfixed \
            employee-center-frontend:${{ github.sha }}
